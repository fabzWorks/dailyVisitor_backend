              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status ok', function () { pm.expect(pm.response.code).to.be.oneOf([201]); });",
                  "const json = pm.response.json();",
                  "pm.test('success = true', function () { pm.expect(json.success).to.eql(true); });",
                  "pm.collectionVariables.set('residentId', json.user.id);"
