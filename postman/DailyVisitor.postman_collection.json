{
  "info": {
    "name": "Daily Visitor API",
    "description": "Poori flow ek hi baar test karne ke liye. Collection ko upar se 'Run collection' karein (ya folders ko is tarteeb se chalayein: Health > Auth > Requests > Notifications > Subscriptions > Deliveries > Skips). Saari ids (residentId, providerId, requestId, subscriptionId, deliveryId) khud save hoti hain.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function fmt(d){ const p = n => String(n).padStart(2,'0'); return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate()); }",
          "const t = new Date(); const tm = new Date(); tm.setDate(t.getDate()+1);",
          "pm.collectionVariables.set('today', fmt(t));",
          "pm.collectionVariables.set('tomorrow', fmt(tm));",
          "pm.collectionVariables.set('startDate', fmt(tm));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "residentEmail",
      "value": "resident@gmail.com"
    },
    {
      "key": "providerEmail",
      "value": "provider@gmail.com"
    },
    {
      "key": "residentId",
      "value": ""
    },
    {
      "key": "providerId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    },
    {
      "key": "subscriptionId",
      "value": ""
    },
    {
      "key": "deliveryId",
      "value": ""
    },
    {
      "key": "today",
      "value": ""
    },
    {
      "key": "tomorrow",
      "value": ""
    },
    {
      "key": "startDate",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status ok', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "const json = pm.response.json();",
                  "pm.test('success = true', function () { pm.expect(json.success).to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
